{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@jmacera/paginate-items": "jsr:@jmacera/paginate-items@^1.0.0",
    "@std/front-matter": "jsr:@std/front-matter@^1.0.9",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "@types/sqlite3": "npm:@types/sqlite3@^5.1.0",
    "drizzle-kit": "npm:drizzle-kit@^0.31.11",
    "drizzle-orm": "npm:drizzle-orm@^0.45.4",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "@preact/signals": "npm:@preact/signals@^2.11.4",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "shikwasa": "npm:shikwasa@^2.2.1",
    "sqlite3": "npm:sqlite3@^6.0.1",
    "vite": "npm:vite@^7.3.8",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "internetarchive-sdk-js": "npm:internetarchive-sdk-js@^1.0.48"
  },
  "links": [
    "../internetarchive-sdk-js"
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
